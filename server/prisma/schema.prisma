generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  citizen
  officer
  admin
}

enum Status {
  Submitted
  UnderReview     @map("Under Review")
  Assigned
  InProgress      @map("In Progress")
  Resolved
}

enum Priority {
  Low
  Medium
  High
  Critical
}

enum Sentiment {
  Positive
  Neutral
  Negative
  HighlyNegative  @map("Highly Negative")
}

enum NotificationType {
  submitted
  status_updated
  assigned
  resolved
  escalated
}

/// How a complaint reached the platform.
///
/// Problem statement 01 asks for intake "via voice, text, and messaging apps",
/// so the channel is recorded as a first-class dimension rather than inferred.
/// It also makes "which channel do citizens actually use" an answerable
/// question, which matters when arguing that a messaging-app route reaches
/// people a web form does not.
///
/// `modelled` is deliberately part of this enum. The demand corpus is
/// synthetic, and calling those rows `web` would be a quiet lie about how they
/// arrived. `isSynthetic` already flags them; this keeps the channel honest too.
enum IntakeChannel {
  web
  voice
  telegram
  whatsapp
  sms
  modelled
}

enum AttachmentKind {
  photo
  video
  audio
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  phone              String?
  name               String
  city               String?
  role               Role          @default(citizen)
  passwordHash       String        @map("password_hash")
  language           String        @default("en")
  twoFactorEnabled   Boolean       @default(false) @map("two_factor_enabled")
  twoFactorSecret    String?       @map("two_factor_secret")
  /// Telegram chat id, when this account was provisioned from a messaging app.
  ///
  /// Unique so a returning sender maps back to the same citizen rather than
  /// accumulating a new account per message. Null for everyone who signed up
  /// through the web.
  telegramChatId     String?       @unique @map("telegram_chat_id")
  departmentId       String?       @map("department_id")
  department         Department?   @relation(fields: [departmentId], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  complaints         Complaint[]   @relation("CitizenComplaints")
  assignedComplaints Complaint[]   @relation("AssignedComplaints")
  notifications      Notification[]
  feedback           Feedback[]
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@map("users")
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  createdAt   DateTime    @default(now()) @map("created_at")

  users       User[]
  complaints  Complaint[]

  @@map("departments")
}

model Complaint {
  id                    String        @id @default(cuid())
  citizenId             String        @map("citizen_id")
  citizen               User          @relation("CitizenComplaints", fields: [citizenId], references: [id])
  title                 String
  description           String
  category              String
  departmentId          String        @map("department_id")
  department            Department    @relation(fields: [departmentId], references: [id])
  assigneeId            String?       @map("assignee_id")
  assignee              User?         @relation("AssignedComplaints", fields: [assigneeId], references: [id])
  priority              Priority      @default(Medium)
  status                Status        @default(Submitted)
  sentiment             Sentiment     @default(Neutral)
  aiConfidence          Float         @default(0) @map("ai_confidence")
  aiSummary             String        @default("") @map("ai_summary")
  language              String        @default("en")
  location              String?
  lat                   Float?
  lng                   Float?

  // Geography. Nullable because complaints filed before the district model
  // existed have no district, and because a citizen may not resolve to one.
  districtId            String?       @map("district_id")
  district              District?     @relation(fields: [districtId], references: [id])

  // True for modelled demand records generated to demonstrate district-level
  // hotspots. Never set on a complaint filed through the app by a real user.
  // Surfaced in the UI and in ATTRIBUTIONS.md so real and modelled demand are
  // never conflated.
  isSynthetic           Boolean       @default(false) @map("is_synthetic")
  /// Which intake route produced this complaint. See IntakeChannel.
  channel               IntakeChannel @default(web)

  // Original-language transcript of a voice submission, before translation.
  // Kept alongside the translated description so multilingual intake is
  // auditable rather than lossy.
  sourceTranscript      String?       @map("source_transcript")
  sourceLanguage        String?       @map("source_language")

  estimatedResolutionAt DateTime?     @map("estimated_resolution_at")
  submittedAt           DateTime      @default(now()) @map("submitted_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  resolvedAt            DateTime?     @map("resolved_at")

  attachments           Attachment[]
  attachmentBlobs       AttachmentBlob[]
  notifications         Notification[]
  feedback              Feedback?

  @@index([status])
  @@index([priority])
  @@index([departmentId, status])
  @@index([citizenId])
  // Drives the district-by-category demand aggregate in the planning engine.
  @@index([districtId, category])
  @@index([isSynthetic])
  @@map("complaints")
}

model Attachment {
  id          String          @id @default(cuid())
  complaintId String          @map("complaint_id")
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  kind        AttachmentKind
  url         String
  sizeBytes   Int             @map("size_bytes")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([complaintId])
  @@map("attachments")
}

/// Raw bytes for an attachment, used by the database storage driver.
///
/// Why store blobs in Postgres at all? The alternative is an S3-compatible
/// bucket, which means a third-party account, credentials and a CORS policy
/// before a single file can be uploaded. That is a hard dependency for a
/// feature that has to work on a free-tier deployment, and an unconfigured
/// bucket fails in a way that looks like a broken app rather than missing
/// configuration. Keeping bytes next to the metadata means uploads work with
/// nothing but a database, and the S3 driver stays available for anyone who
/// needs to scale past that.
///
/// The trade-off is real: `bytes` is a bytea column, so large files consume
/// database storage and every read passes through the API. That is the right
/// call for evidence photos on a demo-scale deployment and the wrong call for
/// a large video library, which is exactly why the driver is swappable.
///
/// Keyed by `objectKey` rather than an id so the S3 and database drivers
/// address objects identically and the calling code does not branch.
model AttachmentBlob {
  objectKey   String    @id @map("object_key")
  complaintId String    @map("complaint_id")
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  contentType String    @map("content_type")
  /// Raw file bytes. Cascade-deleted with the parent complaint so a deleted
  /// complaint cannot leave orphaned storage behind.
  bytes       Bytes
  sizeBytes   Int       @map("size_bytes")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([complaintId])
  @@map("attachment_blobs")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  message     String
  complaintId String           @map("complaint_id")
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([complaintId])
  @@map("notifications")
}

model Feedback {
  id          String     @id @default(cuid())
  complaintId String     @unique @map("complaint_id")
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  citizenId   String     @map("citizen_id")
  citizen     User       @relation(fields: [citizenId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([rating])
  @@map("feedback")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id")
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  at        DateTime @default(now())

  @@index([entity, entityId])
  @@index([at(sort: Desc)])
  @@map("audit_log")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// National planning layer
//
// The grievance side of Nivaran answers "is this citizen's problem fixed?".
// These models answer a different question: "across the country, where should
// the next rupee of infrastructure investment go?". They aggregate citizen
// demand to district level and join it against real Census 2011 demographic
// and household-amenity data.
//
// Design note: every figure the planning engine produces is computed in SQL
// from these tables. Gemini reads the computed aggregates and writes prose
// about them; it never invents a number. See services/planning.
// ---------------------------------------------------------------------------

/// A country, above the state/province tier.
///
/// WHY THIS EXISTS
/// Rule 04 asks for solutions "built for one context but scalable to others
/// across BRICS nations". The administrative hierarchy was already generic —
/// state and district map cleanly onto Estado/Município in Brazil,
/// Oblast/Rayon in Russia, Province/Prefecture in China, Province/District
/// Municipality in South Africa. What actually blocked a second country was not
/// the shape of the data but three *global* unique constraints: `states.name`,
/// `states.census_code` and `districts.census_code`. A Brazilian municipality
/// code of 1 would have collided with Indian census district 1, so a second
/// country was impossible however generic the model looked.
///
/// Those constraints are now scoped per country, which is the difference
/// between portable in principle and portable in fact.
model Country {
  id        String     @id @default(cuid())
  /// ISO 3166-1 alpha-2, e.g. 'IN', 'BR', 'ZA'. The natural upsert key.
  iso2      String     @unique
  /// ISO 3166-1 alpha-3. Kept because several statistical sources key on
  /// alpha-3 rather than alpha-2.
  iso3      String?    @unique
  name      String
  /// ISO 4217 code, e.g. 'INR'. Investment figures are meaningless without
  /// knowing what currency they are denominated in.
  currency  String     @default("INR")
  createdAt DateTime   @default(now()) @map("created_at")

  states    State[]
  districts District[]

  @@map("countries")
}

model State {
  id         String     @id @default(cuid())
  countryId  String     @map("country_id")
  country    Country    @relation(fields: [countryId], references: [id])
  name       String
  /// National statistical code for this state. Named for the Census because
  /// that is the Indian source, but it holds whatever code the country's own
  /// statistical agency publishes. Nullable because union territories and
  /// states reorganised after 2011 may not carry one.
  censusCode Int?       @map("census_code")
  createdAt  DateTime   @default(now()) @map("created_at")

  districts  District[]

  /// Scoped per country, not global: two countries may legitimately share a
  /// state name or a numeric code.
  @@unique([countryId, name])
  @@unique([countryId, censusCode])
  @@map("states")
}

model District {
  id              String   @id @default(cuid())
  /// Denormalised from `state.countryId`.
  ///
  /// Carried directly so the code below can be scoped per country without a
  /// join, and so `@@unique([countryId, censusCode])` is expressible at all —
  /// a composite unique cannot reach through a relation.
  countryId       String   @map("country_id")
  country         Country  @relation(fields: [countryId], references: [id])
  /// National statistical code for this district (1..640 for Census 2011
  /// India). The upsert key for ingest, scoped per country.
  censusCode      Int      @map("census_code")
  /// Local Government Directory code. Reserved for joining scheme-level data
  /// such as Jal Jeevan Mission, which keys on LGD rather than census codes.
  lgdCode         String?  @unique @map("lgd_code")
  name            String
  stateId         String   @map("state_id")
  state           State    @relation(fields: [stateId], references: [id])

  /// Centroid, used to place the district on the map without shipping polygons.
  lat             Float?
  lng             Float?

  // --- Census 2011 absolutes. Rates are derived, not stored, so the raw
  // counts stay auditable against the published tables. ---
  population      Int?
  households      Int?
  literate        Int?
  scPopulation    Int?     @map("sc_population")
  stPopulation    Int?     @map("st_population")
  ruralHouseholds Int?     @map("rural_households")
  urbanHouseholds Int?     @map("urban_households")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  indicators      DistrictIndicator[]
  investments     Investment[]
  complaints      Complaint[]
  recommendations Recommendation[]

  /// Scoped per country. Two countries number their districts from 1.
  @@unique([countryId, censusCode])
  @@index([stateId])
  @@index([name])
  @@index([countryId])
  @@map("districts")
}

/// Tall/long format on purpose. A wide table would need a migration for every
/// new indicator; this shape absorbs new datasets (SDG index, air quality,
/// scheme coverage) without touching the schema.
model DistrictIndicator {
  id         String   @id @default(cuid())
  districtId String   @map("district_id")
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  /// Provenance, e.g. 'census2011'. Every row must be traceable to a dataset.
  source     String
  /// Machine name, e.g. 'no_tapwater_pct'.
  metric     String
  value      Float
  /// 'pct' | 'count' | 'index' — kept so the UI can format without guessing.
  unit       String   @default("pct")
  asOf       DateTime @map("as_of")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([districtId, source, metric, asOf])
  @@index([metric])
  @@map("district_indicators")
}

/// Public money already committed to a district, used to compute investment
/// deficit: high demand plus high deprivation plus low spend equals underserved.
model Investment {
  id              String   @id @default(cuid())
  districtId      String   @map("district_id")
  district        District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  /// Scheme name, e.g. 'Jal Jeevan Mission'.
  scheme          String
  sanctionYear    Int?     @map("sanction_year")
  /// Indian public accounts are published in lakhs; stored as published to
  /// avoid rounding drift, formatted for display at the edge.
  costLakh        Float    @map("cost_lakh")
  expenditureLakh Float    @default(0) @map("expenditure_lakh")
  status          String   @default("unknown")
  source          String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([districtId, scheme])
  @@map("investments")
}

/// A persisted, reproducible prioritisation result for one district-category
/// pair. Scores come from SQL; `rationale` and the JSON fields come from Gemini
/// reading those scores.
model Recommendation {
  id                     String   @id @default(cuid())
  districtId             String   @map("district_id")
  district               District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  category               String
  rank                   Int

  // --- Deterministic sub-scores, each normalised 0..1 ---
  demandScore            Float    @map("demand_score")
  gapScore               Float    @map("gap_score")
  investmentDeficitScore Float    @map("investment_deficit_score")
  equityScore            Float    @map("equity_score")
  priorityScore          Float    @map("priority_score")

  // --- Gemini-authored narrative over the scores above ---
  rationale              String   @default("")
  interventions          Json?
  risks                  Json?
  expectedBeneficiaries  Int?     @map("expected_beneficiaries")

  /// Which model produced the narrative, e.g. 'gemini-2.5-flash', or
  /// 'none' when the ranking rendered without a narrative.
  modelName              String   @map("model_name")
  /// SHA-256 of the exact aggregate payload sent to the model. Lets us prove
  /// which numbers produced which sentence, and detect stale narratives.
  inputDigest            String   @map("input_digest")
  /// True when the narrative step failed and only deterministic scores exist.
  degraded               Boolean  @default(false)
  generatedAt            DateTime @default(now()) @map("generated_at")

  @@index([districtId])
  @@index([category, rank])
  @@map("recommendations")
}
