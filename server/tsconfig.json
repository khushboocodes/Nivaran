{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Type-checking only. Production JavaScript is produced by
    // esbuild.config.mjs, because `moduleResolution: "Bundler"` lets the
    // source use extensionless imports that tsc emits verbatim and Node's
    // ESM loader then refuses to resolve. Emitting from here produced a
    // `dist` tree that could not actually be run.
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@nivaran/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../shared/src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
